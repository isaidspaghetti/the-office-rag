# Streamlit Community Cloud secrets template
# Copy to `.streamlit/secrets.toml` locally (do NOT commit real secrets).

OPENAI_API_KEY = "sk-your-key"

# Qdrant Cloud (or self-hosted)
QDRANT_URL = "https://your-cluster.cloud.qdrant.io"
QDRANT_API_KEY = "your-qdrant-api-key"  # optional for public endpoints

# Two-collection setup (required)
QDRANT_SCRIPTS_COLLECTION = "office_scripts"
QDRANT_DERIVED_COLLECTION = "office_derived_cards"
